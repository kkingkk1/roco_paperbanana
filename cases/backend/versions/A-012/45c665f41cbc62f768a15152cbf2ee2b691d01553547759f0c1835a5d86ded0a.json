{
  "case_id": "A-012",
  "category": "sequential_auction",
  "description": [
    "Initialization only: Iteratively assign task-satellite pair with highest bid = reward * feasible candidate count / ",
    "(1 + assigned duration + task duration); tie-break by smaller task ID, then smaller satellite ID. ",
    "Update load dynamically after each assignment; unassigned if no candidates."
  ],
  "code": [
    "package method.runtime;",
    "import java.util.*;",
    "import method.runtime.SolverContracts.Assignment;",
    "import model.ProblemInstance;",
    "import model.Task;",
    "/** 项目自主设计：逐轮全局竞价，按候选数和当前负载给任务—卫星对报价。 */",
    "public final class A000012 {",
    "  public static Assignment assign(ProblemInstance problem, ProblemAccess api, Budget budget) {",
    "    Map<Integer,Integer> owners=new LinkedHashMap<>();",
    "    Map<Integer,Long> load=new HashMap<>();",
    "    List<Task> remaining=new ArrayList<>(problem.tasks());",
    "    remaining.sort(Comparator.comparingInt(Task::getId));",
    "    while (!remaining.isEmpty()) {",
    "      budget.check();",
    "      Task winner=null;",
    "      Integer bestSat=null;",
    "      double best=Double.NEGATIVE_INFINITY;",
    "      for (Task task:remaining) for (int sat:api.satelliteIds()) {",
    "        budget.check();",
    "        long count=api.candidateCount(task.getId(),sat,budget);",
    "        if (count==0) continue;",
    "        double bid=((double)task.getPriority()*count)/(1.0+load.getOrDefault(sat,0L)+task.getImagingDuration());",
    "        if (winner==null || bid>best ||",
    "            (bid==best && (task.getId()<winner.getId() ||",
    "             (task.getId()==winner.getId() && sat<bestSat)))) {",
    "          winner=task; bestSat=sat; best=bid;",
    "        }",
    "      }",
    "      if (winner==null) {",
    "        for (Task task:remaining) owners.put(task.getId(),null);",
    "        break;",
    "      }",
    "      owners.put(winner.getId(),bestSat);",
    "      load.merge(bestSat,(long)winner.getImagingDuration(),Long::sum);",
    "      remaining.remove(winner);",
    "    }",
    "    return new Assignment(owners);",
    "  }",
    "}",
    ""
  ]
}
