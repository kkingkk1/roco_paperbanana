{
  "case_id": "A-017",
  "category": "best_improvement_move",
  "description": [
    "Initialization: Assign tasks (descending reward, then task ID) to candidate satellite with lowest assigned duration; ",
    "tie-break by smaller ID. Unassigned if no candidates.\n\n",
    "Reassignment (best-improvement local search from base schedule):\n",
    "- Migration: Trial unobserved-task migrations to non-owner satellites with candidates (ascending task ID, then satellite ID).\n",
    "- Swap: Trial swaps between tasks on different satellites with mutual candidates (ascending task IDs).\n",
    "- Acceptance: Select feasible trial with highest total reward strictly above current schedule; retain first on tie. Restart search from Migration upon acceptance.\n",
    "- Termination: Stop if no move improves or timeout expires (retain best verified checkpoint)."
  ],
  "code": [
    "package method.runtime;",
    "import java.util.*;",
    "import java.util.random.RandomGenerator;",
    "import method.runtime.SolverContracts.*;",
    "import model.ProblemInstance;",
    "import model.ScheduledTask;",
    "import model.Task;",
    "/** 项目自主设计：比较未排任务迁移和跨星交换的实际收益，返回最佳改善。 */",
    "public final class A000017 implements A {",
    "  @Override public Assignment initialAssign(ProblemInstance problem,ProblemAccess api,",
    "      Budget budget,RandomGenerator rng) {",
    "    Map<Integer,Integer> owners=new LinkedHashMap<>();",
    "    Map<Integer,Long> load=new HashMap<>();",
    "    List<Task> tasks=problem.tasks().stream()",
    "        .sorted(Comparator.comparingInt(Task::getPriority).reversed().thenComparingInt(Task::getId)).toList();",
    "    for (Task task:tasks) {",
    "      budget.check();",
    "      Integer best=null;",
    "      for (int sat:api.satelliteIds()) {",
    "        budget.check();",
    "        if (!api.hasCandidate(task.getId(),sat,budget)) continue;",
    "        if (best==null || load.getOrDefault(sat,0L)<load.getOrDefault(best,0L) ||",
    "            (load.getOrDefault(sat,0L).equals(load.getOrDefault(best,0L)) && sat<best)) best=sat;",
    "      }",
    "      owners.put(task.getId(),best);",
    "      if (best!=null) load.merge(best,(long)task.getImagingDuration(),Long::sum);",
    "    }",
    "    return new Assignment(owners);",
    "  }",
    "  @Override public MoveTrial searchReassignment(ProblemInstance problem,ProblemAccess api,State state,",
    "      Feedback feedback,MoveEvaluator evaluator,Budget budget,RandomGenerator rng) {",
    "    Set<Integer> scheduled=new HashSet<>();",
    "    long baseline=0;",
    "    for (List<ScheduledTask> timeline:state.timelines().values()) for (ScheduledTask item:timeline) {",
    "      budget.check(); scheduled.add(item.getTaskId()); baseline+=problem.task(item.getTaskId()).getPriority();",
    "    }",
    "    List<Integer> ids=problem.tasks().stream().map(Task::getId).sorted().toList();",
    "    MoveTrial best=null;",
    "    long bestProfit=baseline;",
    "    for (int task:ids) {",
    "      if (scheduled.contains(task)) continue;",
    "      Integer old=state.assignment().owners().get(task);",
    "      for (int sat:api.satelliteIds()) {",
    "        budget.check();",
    "        if (Objects.equals(old,sat) || !api.hasCandidate(task,sat,budget)) continue;",
    "        MoveTrial trial=evaluator.evaluate(state,new Move(state.hash(),Map.of(task,sat)));",
    "        if (trial.state()!=null && trial.totalProfit()>bestProfit) {",
    "          best=trial; bestProfit=trial.totalProfit(); evaluator.checkpoint(trial);",
    "        }",
    "      }",
    "    }",
    "    for (int i=0;i<ids.size();i++) for (int j=i+1;j<ids.size();j++) {",
    "      budget.check();",
    "      int one=ids.get(i),two=ids.get(j);",
    "      Integer ownerOne=state.assignment().owners().get(one),ownerTwo=state.assignment().owners().get(two);",
    "      if (ownerOne==null || ownerTwo==null || ownerOne.equals(ownerTwo) ||",
    "          !api.hasCandidate(one,ownerTwo,budget) || !api.hasCandidate(two,ownerOne,budget)) continue;",
    "      MoveTrial trial=evaluator.evaluate(state,new Move(state.hash(),Map.of(one,ownerTwo,two,ownerOne)));",
    "      if (trial.state()!=null && trial.totalProfit()>bestProfit) {",
    "        best=trial; bestProfit=trial.totalProfit(); evaluator.checkpoint(trial);",
    "      }",
    "    }",
    "    return best;",
    "  }",
    "}",
    ""
  ]
}
