{
  "case_id": "A-011",
  "category": "feedback_price_migration",
  "description": [
    "Initialization: Assign tasks (descending reward, then task ID) to candidate satellite with lowest assigned duration; ",
    "tie-break by smaller ID. Unassigned if no candidates.\n\n",
    "Reassignment (test unobserved task-satellite pairs from base schedule):\n",
    "- Pair Sorting: Sort candidate pairs by descending (reward - penalty), then ascending task and satellite ID (penalties start at 0).\n",
    "- Penalty Update: Increment pair penalty if trial is infeasible or task fails to be scheduled on target.\n",
    "- Acceptance: Select feasible trial with highest total reward strictly above current schedule; retain first on tie.\n",
    "- Termination: Stop when no candidate improves or timeout expires (retain best verified checkpoint)."
  ],
  "code": [
    "package method.runtime;",
    "",
    "import java.util.ArrayList;",
    "import java.util.Comparator;",
    "import java.util.HashMap;",
    "import java.util.HashSet;",
    "import java.util.LinkedHashMap;",
    "import java.util.List;",
    "import java.util.Map;",
    "import java.util.Objects;",
    "import java.util.Set;",
    "import java.util.random.RandomGenerator;",
    "import method.runtime.SolverContracts.A;",
    "import method.runtime.SolverContracts.Assignment;",
    "import method.runtime.SolverContracts.Feedback;",
    "import method.runtime.SolverContracts.Move;",
    "import method.runtime.SolverContracts.MoveEvaluator;",
    "import method.runtime.SolverContracts.MoveTrial;",
    "import method.runtime.SolverContracts.State;",
    "import model.ProblemInstance;",
    "import model.ScheduledTask;",
    "import model.Task;",
    "",
    "/** 本项目设计的反馈价格迁移策略；只用重分配试评更新价格。 */",
    "public final class A000011 implements A {",
    "  private record Pair(int task, int satellite) { }",
    "  private final Map<Pair, Integer> penalties = new HashMap<>();",
    "",
    "  @Override public Assignment initialAssign(ProblemInstance problem, ProblemAccess api,",
    "      Budget budget, RandomGenerator rng) {",
    "    penalties.clear();",
    "    Map<Integer, Integer> owners = new LinkedHashMap<>();",
    "    Map<Integer, Long> load = new HashMap<>();",
    "    List<Task> ordered = problem.tasks().stream()",
    "        .sorted(Comparator.comparingInt(Task::getPriority).reversed().thenComparingInt(Task::getId))",
    "        .toList();",
    "    for (Task task : ordered) {",
    "      budget.check();",
    "      Integer selected = null;",
    "      long selectedLoad = Long.MAX_VALUE;",
    "      for (int satellite : api.satelliteIds()) {",
    "        budget.check();",
    "        if (!api.hasCandidate(task.getId(), satellite, budget)) continue;",
    "        long currentLoad = load.getOrDefault(satellite, 0L);",
    "        if (selected == null || currentLoad < selectedLoad",
    "            || (currentLoad == selectedLoad && satellite < selected)) {",
    "          selected = satellite;",
    "          selectedLoad = currentLoad;",
    "        }",
    "      }",
    "      owners.put(task.getId(), selected);",
    "      if (selected != null) load.merge(selected, (long) task.getImagingDuration(), Long::sum);",
    "    }",
    "    return new Assignment(owners);",
    "  }",
    "",
    "  @Override public MoveTrial searchReassignment(ProblemInstance problem, ProblemAccess api, State state,",
    "      Feedback feedback, MoveEvaluator evaluator, Budget budget, RandomGenerator rng) {",
    "    Set<Integer> scheduled = new HashSet<>();",
    "    long initialProfit = 0;",
    "    for (List<ScheduledTask> timeline : state.timelines().values()) {",
    "      for (ScheduledTask observation : timeline) {",
    "        budget.check();",
    "        scheduled.add(observation.getTaskId());",
    "        initialProfit += problem.task(observation.getTaskId()).getPriority();",
    "      }",
    "    }",
    "    List<Pair> options = new ArrayList<>();",
    "    for (Task task : problem.tasks()) {",
    "      budget.check();",
    "      if (scheduled.contains(task.getId())) continue;",
    "      Integer current = state.assignment().owners().get(task.getId());",
    "      for (int satellite : api.satelliteIds()) {",
    "        budget.check();",
    "        if (!Objects.equals(current, satellite) && api.hasCandidate(task.getId(), satellite, budget)) {",
    "          options.add(new Pair(task.getId(), satellite));",
    "        }",
    "      }",
    "    }",
    "    options.sort(Comparator.<Pair>comparingLong(pair ->",
    "        (long) problem.task(pair.task()).getPriority() - penalties.getOrDefault(pair, 0))",
    "        .reversed().thenComparingInt(Pair::task).thenComparingInt(Pair::satellite));",
    "    MoveTrial best = null;",
    "    long bestProfit = initialProfit;",
    "    for (Pair option : options) {",
    "      budget.check();",
    "      Move move = new Move(state.hash(), Map.of(option.task(), option.satellite()));",
    "      MoveTrial trial = evaluator.evaluate(state, move);",
    "      boolean taskScheduled = trial.state() != null && trial.state().timelines()",
    "          .getOrDefault(option.satellite(), List.of()).stream()",
    "          .anyMatch(o -> o.getTaskId() == option.task());",
    "      if (!taskScheduled) {",
    "        penalties.compute(option, (key, old) -> old == null ? 1 : old == Integer.MAX_VALUE ? old : old + 1);",
    "      }",
    "      if (trial.state() != null && trial.totalProfit() > bestProfit) {",
    "        best = trial;",
    "        bestProfit = trial.totalProfit();",
    "        evaluator.checkpoint(trial);",
    "      }",
    "    }",
    "    return best;",
    "  }",
    "}",
    ""
  ]
}
