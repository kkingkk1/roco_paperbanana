{
  "case_id": "A-015",
  "category": "minimum_squared_load_search",
  "description": [
    "Initialization only: Branch-and-bound search ordered by ascending eligible satellite count, minimizing sum of squared satellite imaging durations. ",
    "Prune branches when lower bound >= best cost. Unassigned if no candidates; return no assignment on budget expiration."
  ],
  "code": [
    "package method.runtime;",
    "import java.util.*;",
    "import method.runtime.SolverContracts.Assignment;",
    "import model.ProblemInstance;",
    "import model.Task;",
    "/** 项目自主设计：穷举合法归属，以成像时长负载平方和为初始分配的选择目标。 */",
    "public final class A000015 {",
    "  private final ProblemInstance problem;",
    "  private final ProblemAccess api;",
    "  private final Budget budget;",
    "  private final List<Task> tasks;",
    "  private final Map<Integer,List<Integer>> choices=new HashMap<>();",
    "  private final Map<Integer,Long> loads=new HashMap<>();",
    "  private final Map<Integer,Integer> current=new LinkedHashMap<>();",
    "  private Map<Integer,Integer> best=null;",
    "  private double bestCost=Double.POSITIVE_INFINITY;",
    "  private A000015(ProblemInstance problem,ProblemAccess api,Budget budget) {",
    "    this.problem=problem; this.api=api; this.budget=budget;",
    "    tasks=new ArrayList<>(problem.tasks());",
    "    for (Task task:tasks) {",
    "      List<Integer> eligible=new ArrayList<>();",
    "      for (int sat:api.satelliteIds()) {",
    "        budget.check();",
    "        if (api.hasCandidate(task.getId(),sat,budget)) eligible.add(sat);",
    "      }",
    "      choices.put(task.getId(),eligible);",
    "    }",
    "    tasks.sort(Comparator.comparingInt((Task t)->choices.get(t.getId()).size()).thenComparingInt(Task::getId));",
    "  }",
    "  public static Assignment assign(ProblemInstance problem,ProblemAccess api,Budget budget) {",
    "    A000015 search=new A000015(problem,api,budget);",
    "    search.visit(0,0.0);",
    "    if (search.best==null) throw new IllegalStateException(\"no assignment produced\");",
    "    return new Assignment(search.best);",
    "  }",
    "  private void visit(int index,double cost) {",
    "    budget.check();",
    "    if (cost>=bestCost) return;",
    "    if (index==tasks.size()) {",
    "      bestCost=cost;",
    "      best=new LinkedHashMap<>(current);",
    "      return;",
    "    }",
    "    Task task=tasks.get(index);",
    "    List<Integer> eligible=choices.get(task.getId());",
    "    if (eligible.isEmpty()) {",
    "      current.put(task.getId(),null);",
    "      visit(index+1,cost);",
    "      current.remove(task.getId());",
    "      return;",
    "    }",
    "    for (int sat:eligible) {",
    "      budget.check();",
    "      long old=loads.getOrDefault(sat,0L);",
    "      long next=old+task.getImagingDuration();",
    "      loads.put(sat,next);",
    "      current.put(task.getId(),sat);",
    "      visit(index+1,cost+(double)next*next-(double)old*old);",
    "      loads.put(sat,old);",
    "      current.remove(task.getId());",
    "    }",
    "  }",
    "}",
    ""
  ]
}
