{
  "case_id": "A-023",
  "category": "min_cost_flow_matching",
  "description": [
    "Successive shortest path matching: Formulate bipartite assignment as minimum-cost flow. ",
    "Normalize costs with non-negative offset; initialize dual node potentials. ",
    "Iteratively augment along shortest source-to-sink paths (Dijkstra) and update potentials until flow saturation."
  ],
