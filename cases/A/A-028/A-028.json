{
  "case_id": "A-028",
  "category": "score_based_multi_assignment",
  "description": [
    "Score-based multi-assignment with fixed resource quotas:\n",
    "- Assignment (default): Order tasks by best score + regret (best minus second-best score); ",
    "greedily assign each to its highest-scoring resource with available slots.\n",
    "- Local Search: Optionally evaluate pairwise task swaps across resources; accept moves ",
    "yielding strictly positive total-score improvement.\n",
    "- Termination: Stop on zero improvement, time limit, iteration limit, or minimum-gain ",
    "threshold."
  ],
